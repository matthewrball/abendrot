.\" Man page for the abendrot CLI.
.\" Render locally with: man ./docs/abendrot.1 (or: groff -man -Tascii docs/abendrot.1)
.TH ABENDROT 1 "November 12, 2026" "abendrot 1.0.2" "User Commands"
.SH NAME
abendrot \- control the Abendrot screen-warmth app from the terminal or an AI assistant
.SH SYNOPSIS
.B abendrot
.I subcommand
.RI [ options ]
.br
.B abendrot status
.RB [ \-\-json ]
.br
.B abendrot get
.I key
.RB [ \-\-json ]
.br
.B abendrot on
|
.B off
.RB [ \-\-json ]
.br
.B abendrot cozy
.BR on | off
.RB [ \-\-json ]
.br
.B abendrot set warmth
.RI [ strength ]
.RB [ \-\-kelvin
.IR kelvin ]
.RB [ \-\-json ]
.br
.B abendrot set mode
.I mode
.RB [ \-\-json ]
.br
.B abendrot set max-warmth
.I kelvin
.RB [ \-\-json ]
.br
.B abendrot set reveal-mode
.I mode
.RB [ \-\-json ]
.br
.B abendrot set location
.RI [ latitude ]
.RI [ longitude ]
.RB [ \-\-auto ]
.RB [ \-\-json ]
.br
.B abendrot exclude add
|
.B remove
.I bundle-id
.RB [ \-\-json ]
.br
.B abendrot exclude list
.RB [ \-\-json ]
.br
.B abendrot pause
.BR hour | sunrise | resume
.RB [ \-\-json ]
.br
.B abendrot pause fullscreen
.BR on | off
.RB [ \-\-json ]
.br
.B abendrot late-night
.RB [ status ]
.RB [ \-\-json ]
.br
.B abendrot late-night
.BR on | off
.RB [ \-\-json ]
.br
.B abendrot late-night bedtime
.I time
.RB [ \-\-json ]
.br
.B abendrot late-night warmth
.RI [ strength ]
.RB [ \-\-kelvin
.IR kelvin ]
.RB [ \-\-json ]
.br
.B abendrot late-night cozy
.BR on | off
.RB [ \-\-json ]
.br
.B abendrot late-night ease
.I minutes
.RB [ \-\-json ]
.br
.B abendrot debug fullscreen
.RB [ \-\-delay
.IR seconds ]
.br
